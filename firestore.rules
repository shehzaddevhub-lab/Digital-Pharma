rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default Deny All
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    // Super Admin: Reserved for M Shahzad Khakh (03067717634)
    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'shzdkhkh01@gmail.com' || 
        request.auth.uid == 'admin_shzdkhkh01' || 
        request.auth.uid == 'admin_shahzad_03067717634' ||
        request.auth.uid.matches('^admin_.*')
      );
    }

    function isOwner(userId) {
      return isSignedIn() && (request.auth.uid == userId || userId.matches('^ph_.*') || isAdmin());
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Public Connected Pharmacies Directory (Connects all pharmacies together)
    match /pharmacies/{pharmacyId} {
      allow read: if true;
      allow create, update: if isValidId(pharmacyId) && (
        request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 120
      );
      allow delete: if isAdmin() || isOwner(pharmacyId);
    }

    // User Account Root Document (for direct auth & sync profile)
    match /users/{userId} {
      allow read, write: if isOwner(userId);
    }

    // User-Owned Private Medicine Stock Inventory
    match /users/{userId}/medicines/{medId} {
      allow read, write: if isOwner(userId) && isValidId(medId);
    }

    // User-Owned Private Sales Invoices & Khata
    match /users/{userId}/sales/{saleId} {
      allow read, write: if isOwner(userId) && isValidId(saleId);
    }

    // User-Owned Store Profile Configuration
    match /users/{userId}/profile/{docId} {
      allow read, write: if isOwner(userId);
    }
  }
}
