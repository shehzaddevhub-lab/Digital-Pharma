rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default Deny All
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Public Connected Pharmacies Directory
    match /pharmacies/{pharmacyId} {
      allow read: if true;
      allow create, update: if isValidId(pharmacyId) && (
        request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 120 &&
        request.resource.data.phone is string && request.resource.data.phone.size() > 0 && request.resource.data.phone.size() <= 40
      );
      allow delete: if false;
    }

    // User-Owned Private Medicine Stock Inventory
    match /users/{userId}/medicines/{medId} {
      allow read, write: if isOwner(userId) && isValidId(medId);
    }

    // User-Owned Private Sales Invoices & Khata
    match /users/{userId}/sales/{saleId} {
      allow read, write: if isOwner(userId) && isValidId(saleId);
    }

    // User-Owned Store Profile Configuration
    match /users/{userId}/profile/{docId} {
      allow read, write: if isOwner(userId);
    }
  }
}
